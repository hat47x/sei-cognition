{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sei-cognition.example/contracts/v1alpha1/semantic-reference.schema.json",
  "title": "SEI Semantic Reference v1alpha1",
  "description": "Machine-readable representation of sei.semantic-reference/v1alpha1. The Markdown Contract Definition remains the semantic normative source.",
  "type": "object",
  "required": ["contract", "record_type"],
  "properties": {
    "contract": {
      "const": "sei.semantic-reference/v1alpha1"
    },
    "record_type": {
      "enum": ["logical_reference", "exact_binding", "semantic_lineage", "verification_outcome"]
    },
    "logical_reference": {
      "$ref": "#/$defs/logicalReference"
    },
    "exact_binding": {
      "$ref": "#/$defs/exactBinding"
    },
    "semantic_lineage": {
      "$ref": "#/$defs/semanticLineage"
    },
    "verification_outcome": {
      "$ref": "#/$defs/verificationOutcome"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"record_type": {"const": "logical_reference"}}},
      "then": {"required": ["logical_reference"]}
    },
    {
      "if": {"properties": {"record_type": {"const": "exact_binding"}}},
      "then": {"required": ["exact_binding"]}
    },
    {
      "if": {"properties": {"record_type": {"const": "semantic_lineage"}}},
      "then": {"required": ["semantic_lineage"]}
    },
    {
      "if": {"properties": {"record_type": {"const": "verification_outcome"}}},
      "then": {"required": ["verification_outcome"]}
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "logicalReference": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "profileIdentity": {
      "type": "object",
      "required": ["profile_id", "version"],
      "properties": {
        "profile_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "exactBinding": {
      "type": "object",
      "required": ["logical_ref", "content_digest", "representation_profile"],
      "properties": {
        "logical_ref": {"$ref": "#/$defs/logicalReference"},
        "content_digest": {"type": "string", "minLength": 1},
        "representation_profile": {"$ref": "#/$defs/profileIdentity"}
      },
      "additionalProperties": false
    },
    "referenceEndpoint": {
      "oneOf": [
        {"$ref": "#/$defs/logicalReference"},
        {"$ref": "#/$defs/exactBinding"}
      ]
    },
    "semanticLineage": {
      "type": "object",
      "required": ["relation", "from", "to"],
      "properties": {
        "relation": {"enum": ["revises", "supersedes", "withdraws"]},
        "from": {"$ref": "#/$defs/referenceEndpoint"},
        "to": {"$ref": "#/$defs/referenceEndpoint"},
        "basis_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/logicalReference"},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "verificationOutcome": {
      "type": "object",
      "required": ["binding", "status"],
      "properties": {
        "binding": {"$ref": "#/$defs/exactBinding"},
        "status": {"enum": ["verified", "failed", "not_verified"]},
        "reason": {"type": "string", "minLength": 1},
        "verifier_ref": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
