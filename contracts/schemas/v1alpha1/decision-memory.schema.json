{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sei-cognition.example/contracts/v1alpha1/decision-memory.schema.json",
  "title": "SOZA Decision Memory v1alpha1",
  "description": "Machine-readable representation of sei.decision-memory/v1alpha1. Decision and Recommendation remain distinct records; neither encodes authorization or execution state.",
  "type": "object",
  "required": ["contract", "record_type"],
  "properties": {
    "contract": {
      "const": "sei.decision-memory/v1alpha1"
    },
    "record_type": {
      "enum": ["decision", "recommendation"]
    },
    "decision": {
      "$ref": "#/$defs/decision"
    },
    "recommendation": {
      "$ref": "#/$defs/recommendation"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"record_type": {"const": "decision"}}},
      "then": {"required": ["decision"], "not": {"required": ["recommendation"]}}
    },
    {
      "if": {"properties": {"record_type": {"const": "recommendation"}}},
      "then": {"required": ["recommendation"], "not": {"required": ["decision"]}}
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "logicalReference": {
      "$ref": "semantic-reference.schema.json#/$defs/logicalReference"
    },
    "exactBinding": {
      "$ref": "semantic-reference.schema.json#/$defs/exactBinding"
    },
    "reference": {
      "oneOf": [
        {"$ref": "#/$defs/logicalReference"},
        {"$ref": "#/$defs/exactBinding"}
      ]
    },
    "recommendation": {
      "type": "object",
      "required": ["ref", "statement"],
      "properties": {
        "ref": {"$ref": "#/$defs/logicalReference"},
        "statement": {"type": "string", "minLength": 1},
        "context_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/reference"},
          "uniqueItems": true
        },
        "basis_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/reference"},
          "uniqueItems": true
        },
        "rationale": {"type": "string", "minLength": 1},
        "responsibility_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/reference"},
          "uniqueItems": true
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": ["ref", "statement"],
      "properties": {
        "ref": {"$ref": "#/$defs/logicalReference"},
        "statement": {"type": "string", "minLength": 1},
        "context_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/reference"},
          "uniqueItems": true
        },
        "basis_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/reference"},
          "uniqueItems": true
        },
        "recommendation_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/reference"},
          "uniqueItems": true
        },
        "unresolved_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/reference"},
          "uniqueItems": true
        },
        "responsibility_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/reference"},
          "uniqueItems": true
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "lineage": {
          "$ref": "semantic-reference.schema.json#/$defs/semanticLineage"
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  }
}
